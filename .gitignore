# Environment
.env
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Experiment outputs + downloaded CI artifacts (reproducible, not tracked)
results/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# API key safety: block any file matching real key patterns
# (defense-in-depth — .env gitignore is the primary control)
*.key
*.pem

# Planning/tooling artifacts — local only
.superpowers/
docs/superpowers/

# Claude Code private state: worktrees, codebase map, memory, etc.
# Worktrees contain nested .git dirs → git warns about "embedded repository"
# and creates dangling gitlinks. Keep all of Claude Code's workspace local.
.claude/

# Top-level experiment-output dumps from GHA artifact extraction.
# Real results always live under results/ (already ignored above).
/A4/
/experiment-A4-*/
